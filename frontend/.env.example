# Copy to .env.local for local dev. NEXT_PUBLIC_* is inlined at `next build` time — use the same
# values in CI/production env so builds do not bake in the wrong API base URL.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Optional: Playwright uses port 3000 locally; in CI it serves on 9323 via `next build` + `next start`.
# PLAYWRIGHT_DEV_PORT=3000
